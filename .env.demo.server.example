# Server demo settings — TEMPLATE ONLY. Never put real values in this file.
#
# On the VPS: copy to /opt/tenderbazaar-demo/.env.demo.server, `chmod 600` it,
# and fill every secret with a value generated ON THE VPS, e.g.:
#     openssl rand -hex 32        (JWT secrets: 64 characters)
#     openssl rand -hex 24        (other passwords and tokens)
# Passwords are used in connection URLs: letters and digits only (hex is fine).
# Used only via:  docker compose -p tenderbazaar-demo --env-file .env.demo.server ...

# ── Required secrets (the stack refuses to start without them) ──────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SCRAPER_API_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Required demo accounts (passwords: 12+ characters) ──────────────────────
# SUPER_ADMIN (yours). Created once by db-init; never changed afterwards.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Demo Administrator
# ADMIN (the client's). Created once by demo-seed; never changed afterwards.
DEMO_STAFF_ADMIN_EMAIL=
DEMO_STAFF_ADMIN_PASSWORD=

# ── Browser origins allowed by the API (CORS) ───────────────────────────────
# Private phase (SSH tunnel):  http://localhost:8080  and  http://localhost:8081
# Public phase (HTTPS later):  https://demo.<host>     and  https://admin.<host>
# Changing these needs only a restart of api-server — no rebuild.
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081

# ── Simulated scraper (optional; defaults shown) ────────────────────────────
DEMO_SCHEDULE_ENABLED=true
DEMO_FAILURE_EVERY=6
DEMO_PAGE_ERRORS_EVERY=3
DEMO_CONCURRENCY=2
# Per-portal UTC cron, or "off". Empty = built-in schedule (every 2–6 hours).
DEMO_CRON_GEM_DEMO=
DEMO_CRON_CPPP_DEMO=
DEMO_CRON_EPROCURE_DEMO=
DEMO_CRON_MAHARASHTRA_DEMO=
DEMO_CRON_GUJARAT_DEMO=
DEMO_CRON_RAJASTHAN_DEMO=
