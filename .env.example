# ═══════════════════════════════════════════════════════════════
# TenderBazaar Environment Variables
# Copy this file to .env and fill in your values.
#
# TWO FILES IN PRODUCTION:
#   .env             read by Compose itself, to interpolate ${...} in the
#                    compose files. Needed in development AND production.
#   .env.production  injected into the BACKEND containers as their runtime
#                    environment (api-server, scraper, notification-service,
#                    db-init). Optional; omit it if you inject secrets from an
#                    orchestrator secret store instead. web/admin get neither —
#                    their config is baked from NEXT_PUBLIC_* at build time.
#   docker-compose.yml itself declares no env_file: Compose MERGES env_file
#   lists, so an entry there could never be overridden away and leaked the
#   developer environment into production. See docs/DEPLOYMENT.md.
#
# Start the stack with:
#   development  docker compose up -d
#   production   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#                (or ./scripts/docker-start.sh --prod)
#
# ───────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST — Compose refuses to start without these:
#   POSTGRES_PASSWORD      strong, URL-safe
#   REDIS_PASSWORD         strong, URL-safe
#   SCRAPER_API_TOKEN      >= 16 chars, not a placeholder
#   FRONTEND_URL           public web origin (https://…)
#   ADMIN_URL              public admin origin (https://…)
# The API server additionally refuses to boot without:
#   NODE_ENV=production    on any hosted platform (Render sets RENDER=true).
#                          Production also requires DATABASE_URL, an https
#                          FRONTEND_URL (no localhost) and a REDIS_URL that
#                          carries a real password.
#   JWT_SECRET             >= 32 chars, not a placeholder, != refresh secret
#   JWT_REFRESH_SECRET     >= 32 chars, not a placeholder
# Set BEFORE `docker compose … build` (baked into the browser bundle):
#   NEXT_PUBLIC_API_URL    e.g. https://api.example.com/api/v1
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID (only if Google sign-in is used)
#
# PASSWORD CHARACTERS: POSTGRES_PASSWORD and REDIS_PASSWORD are interpolated
# into connection URLs by docker-compose.yml, so use only URL-unreserved
# characters (A-Z a-z 0-9 - _ . ~) or percent-encode them. db-init refuses to
# run on a password that would corrupt the URL.
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
# The API listens on PORT (hosting platforms set it; 4000 locally).
PORT=4000

# ─── Database (PostgreSQL) ───────────────────────────────────
# DATABASE_URL is for tooling run on the HOST (prisma studio, migrations, the
# seed). Inside Compose each service receives its own DATABASE_URL built from
# POSTGRES_PASSWORD, so you do not need to keep the two in sync.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenderbazaar
# Production: REQUIRED, set a strong URL-safe password.
POSTGRES_PASSWORD=postgres

# ─── Database initialization (db-init container) ─────────────
# db-init applies committed Prisma migrations (`prisma migrate deploy`). It no
# longer runs `prisma db push --accept-data-loss`, and it no longer seeds by
# default. Seeding is opt-in because the seed creates administrator accounts
# and demo tenders:
DB_INIT_SEED=false
# Seed behaviour (used only when a seed actually runs):
#   SEED_DEMO_DATA       insert the 60 sample tenders. Defaults to true outside
#                        production, false in production.
#   SEED_ADMIN_EMAIL /   create ONE administrator when it does not exist.
#   SEED_ADMIN_PASSWORD  Required in production to create any admin at all;
#                        min 12 chars. An EXISTING admin is never modified, so
#                        a redeploy can no longer reset a password.
#   SEED_ADMIN_NAME      optional display name.
# SEED_DEMO_DATA=true
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ─── Redis ───────────────────────────────────────────────────
# As with DATABASE_URL, this value is for host-side tooling; Compose builds the
# in-network URL from REDIS_PASSWORD.
REDIS_URL=redis://localhost:6379
# Production: REQUIRED. 'changeme' is rejected at API startup.
REDIS_PASSWORD=changeme
# Production normally requires the password inside REDIS_URL. A URL WITHOUT a
# password is accepted only with this explicit opt-in, which states that the
# Redis instance is reachable solely on a private network (Render Key Value's
# default internal URL, redis://<host>:6379, has no credentials). It never
# relaxes the placeholder-password, malformed-URL or localhost checks. Leave
# false everywhere else.
REDIS_ALLOW_UNAUTHENTICATED=false

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
# Elasticsearch is OPTIONAL. Tender search falls back to PostgreSQL whenever it
# is unreachable, and /health only reports "degraded" (HTTP 200). Set false on
# a deployment without a cluster: no index setup or boot reindex is attempted.
ELASTICSEARCH_ENABLED=true
# HOST PREREQUISITE: Elasticsearch 8.x needs a raised mmap count on Linux:
#   sudo sysctl -w vm.max_map_count=262144
#   echo 'vm.max_map_count=262144' | sudo tee /etc/sysctl.d/99-elasticsearch.conf
# Without it the container exits with a bootstrap check failure.

# ─── JWT Authentication ─────────────────────────────────────
# The values below are PLACEHOLDERS and are rejected when NODE_ENV=production
# (too short, and they match the "change in production" pattern). Generate real
# ones, independently:   openssl rand -base64 48
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# Shared secret between api-server and the AI service. The AI service requires
# `Authorization: Bearer <token>` on every endpoint except /health and refuses
# all of them (503) while this is unset; api-server sends the same value.
# Server-side only: never put it in a NEXT_PUBLIC_* variable. Production
# rejects short or placeholder values.      openssl rand -hex 24
AI_SERVICE_TOKEN=dev-ai-service-token
# Browser origins the AI service answers CORS for. Empty (recommended): only
# api-server calls it, no CORS headers are sent. Wildcards are ignored.
AI_SERVICE_ALLOWED_ORIGINS=
# Interactive OpenAPI docs of the AI service; off unless true.
AI_SERVICE_EXPOSE_DOCS=false

# ─── Razorpay Payments ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── AWS S3 (Document Storage) ──────────────────────────────
# NOTE: the S3 upload path in packages/api-server/src/shared/utils/upload.ts is
# currently commented out, so these three are inert today. The names below are
# the ones that code reads when it is enabled — the previously documented
# AWS_S3_BUCKET / AWS_ACCESS_KEY / AWS_SECRET_KEY were never read by anything.
S3_BUCKET=tenderbazaar-documents
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1

# ─── Email delivery ─────────────────────────────────────────
# PRODUCTION: one provider is REQUIRED. notification-service picks, in order,
# custom SMTP (SMTP_HOST + SMTP_USER + SMTP_PASS, optional SMTP_PORT), Gmail
# (GMAIL_USER + GMAIL_APP_PASSWORD) or AWS SES (the AWS_SES_* block below).
# With none configured, development prints each email to the console; in
# production every EMAIL job (password resets, alerts, subscription notices)
# fails with EMAIL_NOT_CONFIGURED instead of being reported as sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# ─── AWS SES (Email) ────────────────────────────────────────
# AWS_SES_FROM_EMAIL is the name notification-service reads. It was previously
# documented here as EMAIL_FROM, which nothing reads — so a faithfully filled-in
# .env left the sender address unset with no error.
# UNUSED: notification-service reads AWS_REGION, not AWS_SES_REGION. Kept only
# so an existing .env does not look broken; set AWS_REGION above instead.
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY=your-ses-access-key
AWS_SES_SECRET_KEY=your-ses-secret-key
AWS_SES_FROM_EMAIL=noreply@tenderbazaar.com

# ─── WhatsApp (WATI) ────────────────────────────────────────
# WATI_API_KEY is the name notification-service reads; it was previously
# documented as WATI_API_TOKEN, which nothing reads.
WATI_API_URL=https://live-server.wati.io
WATI_API_KEY=your-wati-api-key

# ─── SMS (MSG91) ────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=TNDBZR
MSG91_TEMPLATE_ID=your-msg91-template-id
SMS_API_KEY=your-msg91-api-key

# ─── Firebase (Push Notifications) ──────────────────────────
FIREBASE_PROJECT_ID=tenderbazaar
# Path INSIDE the container to a Firebase service-account JSON key. Required for
# push to work: FIREBASE_PROJECT_ID alone makes Firebase Admin fall back to
# Application Default Credentials, which do not exist in the container, and every
# send then fails silently.
#
# Supply it as a read-only mount (docker-compose.prod.yml mounts
# ./secrets/firebase-service-account.json). Never commit the key; never put it
# in an environment variable, where it would leak into `docker inspect`.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# true  -> notification-service refuses to start without a usable push credential
# false -> starts, reports push disabled, other channels keep working (default)
PUSH_NOTIFICATIONS_REQUIRED=false
# UNUSED as written: providers/push.ts calls initializeApp({ projectId }) with no
# credential, so firebase-admin falls back to Application Default Credentials,
# which do not exist in the container. Supplying either name below has no
# effect and push cannot authenticate. Wiring a service-account credential is
# outstanding work — see docs/DEPLOYMENT.md.
FIREBASE_PRIVATE_KEY=your-firebase-private-key
# UNUSED — see the note above FIREBASE_PRIVATE_KEY.
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ─── Google OAuth ────────────────────────────────────────────
# The OAuth client id(s) whose Google ID tokens the API accepts, comma-separated
# when web and mobile use different clients. Every token is verified against
# Google's published keys (signature, issuer, audience, expiry, verified email)
# in EVERY environment; there is no unsigned path. Leave EMPTY to disable
# Google sign-in (POST /auth/google answers 503). Production refuses to start
# on a value that is not a real *.apps.googleusercontent.com client id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Baked into the browser bundle at BUILD time. Leave EMPTY unless Google
# sign-in is configured — an unset value is better than shipping the literal
# string "your-google-client-id" to production browsers.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# RETIRED. This used to switch on a sign-in path that accepted an UNSIGNED,
# client-generated Google token for any email, administrators included. That
# path has been removed; Google ID tokens are always verified. The variable is
# still parsed so a stale 'true' is caught: production refuses to start with
# it. Leave it unset or false.
ALLOW_DEMO_GOOGLE_AUTH=false

# ─── App URLs ───────────────────────────────────────────────
# Production: FRONTEND_URL and ADMIN_URL are REQUIRED and must be https origins
# (no localhost, no path, no wildcard). Together with CORS_ORIGINS they are the
# complete CORS allow-list of the API: a browser page on any other origin is
# refused with 403 before any route runs. Localhost origins are added only when
# NODE_ENV=development.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Further exact origins to trust, comma-separated (for example a custom domain
# next to the *.vercel.app one). Wildcards are rejected at startup. Usually empty.
CORS_ORIGINS=
API_URL=http://localhost:4000

# ─── Frontend (Next.js public vars) ─────────────────────────
# NEXT_PUBLIC_* are INLINED INTO THE CLIENT BUNDLE AT BUILD TIME. Setting them
# only at runtime has no effect on the browser — rebuild after changing them.
#
# For a production deployment this must be the public URL the BROWSER can
# reach, not an internal Compose hostname. Typical arrangements:
#   * reverse proxy (nginx/Caddy/Traefik) terminating TLS and routing
#     https://api.example.com -> api-server:4000   (recommended)
#   * api-server's published port behind TLS: https://example.com:4000/api/v1
# Replace example.com with your own domain; there is no default that works.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Demo builds only (set by docker-compose.demo-local.yml): emails the admin login
# page's Super Admin / Admin tabs fill instead of the development seed accounts.
# Leave empty for the normal app.
NEXT_PUBLIC_DEMO_SUPER_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
# UNUSED: no code in apps/web or apps/admin reads this.
NEXT_PUBLIC_APP_NAME=TenderBazaar
# UNUSED: no code in apps/web or apps/admin reads this.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Sentry (Error Tracking) ────────────────────────────────
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ─── Scraper control API ────────────────────────────────────
# The scraper engine exposes scheduler start/stop, portal run and portal toggle
# on port 4001. These endpoints require this shared secret; api-server sends the
# same value. Production boot FAILS if it is missing, under 16 characters, or a
# known placeholder. The port is published to the host only in development.
#   openssl rand -hex 24
SCRAPER_API_TOKEN=dev-scraper-api-token
# Where api-server looks for the engine (Compose service name by default).
SCRAPER_API_URL=http://scraper:4001
SCRAPER_API_PORT=4001
SCRAPER_API_ENABLED=true
# Comma-separated browser origins allowed to call the control API. Empty (the
# default) sends no CORS headers at all, which is correct for service-to-service
# use. CORS is not authentication.
SCRAPER_API_ALLOWED_ORIGINS=
# When the engine is unreachable, api-server publishes the run onto the BullMQ
# queue instead. docker-compose.demo.yml sets false (no queue consumer there).
SCRAPER_QUEUE_FALLBACK=true

# ─── Demo scraper (docker-compose.demo.yml only) ────────────
# Simulated runs for presentations: no browser, no portal requests, no tenders
# written. See docs/DEMO.md. Ignored by the real scraper engine.
# DEMO_SCRAPER_MODE=true          # set by Dockerfile.demo; boot refuses otherwise
# DEMO_SCHEDULE_ENABLED=false     # true = simulated runs on a cron as well
# DEMO_CONCURRENCY=2              # simulated runs at once; others wait as PENDING
# DEMO_START_DELAY_MIN_MS=1500
# DEMO_START_DELAY_MAX_MS=4000
# DEMO_PAGE_DELAY_MIN_MS=1800     # pause per simulated page
# DEMO_PAGE_DELAY_MAX_MS=4200

# ─── Scraper portals (enable/disable per portal) ────────────
#
# THE DEFAULT DEPENDS ON NODE_ENV:
#
#   NODE_ENV=production    every real portal defaults to DISABLED.
#                          Contacting a real government portal must be an
#                          explicit, per-portal decision — so in production you
#                          MUST set the ones you want to true, by name. A
#                          production stack that sets none of these scrapes
#                          nothing, which is the intended safe default.
#
#   anything else          every real portal defaults to ENABLED, so local
#                          development behaves as it always has.
#
# Setting one to false is a hard kill switch applied at container start: it is
# ANDed with the per-portal toggle in the database, so a portal disabled here
# CANNOT be switched back on from the admin UI — it needs this variable plus a
# container restart. That is deliberate. See docs/DEPLOYMENT.md § Portal
# enablement policy.
#
# Uncomment and set to true, per portal, to opt in on a production deployment:
# PORTAL_GEM_ENABLED=true
# PORTAL_CPPP_ENABLED=true
# PORTAL_EPROCURE_ENABLED=true
# PORTAL_GUJARAT_ENABLED=true
# PORTAL_MAHARASHTRA_ENABLED=true
# PORTAL_RAJASTHAN_ENABLED=true
# PORTAL_KARNATAKA_ENABLED=true
# PORTAL_TAMILNADU_ENABLED=true
# PORTAL_UP_ENABLED=true
# PORTAL_MP_ENABLED=true
# PORTAL_DELHI_ENABLED=true
# PORTAL_KERALA_ENABLED=true
# PORTAL_WB_ENABLED=true

# ─── Scraper tuning ────────────────────────────────────────
# SCRAPER_CONCURRENCY=2            parallel detail fetches within one run
# SCRAPER_REQUEST_DELAY_MS=2000    politeness delay between requests
# SCRAPER_RETRY_COUNT=3            HTTP retries per page
# SCRAPER_RETRY_DELAY_MS=1000      base delay for HTTP retry backoff
# SCRAPER_TIMEOUT_MS=30000         per-request timeout
# SCRAPER_MAX_PAGES=10             default listing-page budget per run
# SCRAPER_RESPECT_ROBOTS_TXT=true
# SCRAPER_UA_ROTATION=true
#
# TLS: certificate verification is ON. This escape hatch is for debugging a
# portal with a broken certificate chain ONLY, is ignored when
# NODE_ENV=production, and prints a warning. Prefer NODE_EXTRA_CA_CERTS for a
# genuinely missing intermediate certificate.
# SCRAPER_ALLOW_INSECURE_TLS=false

# ─── Queues (BullMQ) ───────────────────────────────────────
# QUEUE_CONCURRENCY=3              portals scraped in parallel by the worker
# QUEUE_RETRY_ATTEMPTS=3
# QUEUE_RETRY_BACKOFF_MS=5000
# QUEUE_KEEP_COMPLETED=1000
# QUEUE_KEEP_FAILED=500
# Queue names must match on both producer and consumer:
# SCRAPER_JOBS_QUEUE=scraper-jobs          api-server -> scraper engine
# TENDER_INDEX_QUEUE=tender-index          scraper engine -> api-server (ES sync)
# ALERT_EVALUATION_QUEUE=alert-evaluation  api-server internal

# ─── Playwright ────────────────────────────────────────────
# Currently unused: all 13 scrapers use axios + cheerio. See
# packages/scraper-engine/PLAYWRIGHT.md before enabling.
# PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_MAX_CONTEXTS=3
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ─── Outbound proxies (optional) ───────────────────────────
# Comma-separated proxy URLs for scraper egress. Relevant if a target portal
# restricts access by geography; empty means direct egress from the host.
# PROXY_URLS=
# PROXY_ROTATE_PER_REQUEST=true

# ─── Logging ───────────────────────────────────────────────
# LOG_LEVEL=info                   debug | info | warn | error
# LOG_CONSOLE=true
# LOG_FILE=false
# LOG_FILE_PATH=./logs/scraper.log

# ─── Rate limiting (per 15-minute window) ───────────────────────────────────
# Optional. Must be positive whole numbers; malformed values fail at startup.
# RATE_LIMIT_AUTHED_MAX: per-user ceiling for authenticated requests.
# RATE_LIMIT_ANON_MAX:   per-IP ceiling for anonymous requests.
# RATE_LIMIT_AUTH_MAX:   per-IP ceiling for FAILED authentication attempts.
# The schema's built-in defaults (10000/3000/500) are permissive development
# values; docker-compose.prod.yml pins 600/120/20 for production.
RATE_LIMIT_AUTHED_MAX=1000
RATE_LIMIT_ANON_MAX=300
RATE_LIMIT_AUTH_MAX=20
#
# DISABLE_RATE_LIMIT: development-only escape hatch for local work, where one
# page can fan out to many endpoints. Must be exactly 'true' or 'false'
# (anything else fails at startup); defaults to 'false'.
#
# It is honoured ONLY when NODE_ENV=development. Setting it to 'true' in
# production or test has no effect — rate limiting stays on — so this cannot be
# used to switch off protection on a deployed server. It never affects
# authentication itself, only the request counting.
DISABLE_RATE_LIMIT=false
