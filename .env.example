# ═══════════════════════════════════════════════════════════════
# TenderBazaar Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenderbazaar
# Production: set a strong password
POSTGRES_PASSWORD=postgres

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Production: set a password
REDIS_PASSWORD=changeme

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Razorpay Payments ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── AWS S3 (Document Storage) ──────────────────────────────
AWS_S3_BUCKET=tenderbazaar-documents
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=ap-south-1

# ─── AWS SES (Email) ────────────────────────────────────────
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY=your-ses-access-key
AWS_SES_SECRET_KEY=your-ses-secret-key
EMAIL_FROM=noreply@tenderbazaar.com

# ─── WhatsApp (WATI) ────────────────────────────────────────
WATI_API_URL=https://live-server.wati.io
WATI_API_TOKEN=your-wati-api-token
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_API_URL=https://api.wati.io/api/v1

# ─── SMS (MSG91) ────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=TNDBZR
MSG91_TEMPLATE_ID=your-msg91-template-id
SMS_API_KEY=your-msg91-api-key

# ─── Firebase (Push Notifications) ──────────────────────────
FIREBASE_PROJECT_ID=tenderbazaar
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Development-only Google sign-in. When enabled, the web app shows a demo
# account chooser and the API accepts an UNSIGNED, client-generated ID token.
# Anyone able to reach the API could then sign in as any user, so:
#   * leave this false everywhere except a local machine, and
#   * the API ignores it unless NODE_ENV=development.
# Both must be set to use the demo flow locally.
ALLOW_DEMO_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_GOOGLE_AUTH=false

# ─── App URLs ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# ─── Frontend (Next.js public vars) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=TenderBazaar
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Sentry (Error Tracking) ────────────────────────────────
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ─── Rate limiting (per 15-minute window) ───────────────────────────────────
# Optional. Must be positive whole numbers; malformed values fail at startup.
# RATE_LIMIT_AUTHED_MAX: per-user ceiling for authenticated requests.
# RATE_LIMIT_ANON_MAX:   per-IP ceiling for anonymous requests.
# RATE_LIMIT_AUTH_MAX:   per-IP ceiling for FAILED authentication attempts.
RATE_LIMIT_AUTHED_MAX=1000
RATE_LIMIT_ANON_MAX=300
RATE_LIMIT_AUTH_MAX=20
#
# DISABLE_RATE_LIMIT: development-only escape hatch for local work, where one
# page can fan out to many endpoints. Must be exactly 'true' or 'false'
# (anything else fails at startup); defaults to 'false'.
#
# It is honoured ONLY when NODE_ENV=development. Setting it to 'true' in
# production or test has no effect — rate limiting stays on — so this cannot be
# used to switch off protection on a deployed server. It never affects
# authentication itself, only the request counting.
DISABLE_RATE_LIMIT=false
