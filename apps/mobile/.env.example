# Copy to .env (gitignored). Read at build time by react-native-config.
# Physical Android phone over USB: run `adb reverse tcp:4000 tcp:4000` and keep localhost,
# or replace localhost with your PC's LAN IP (phone and PC on the same Wi-Fi).
# Without API_URL the app falls back to src/utils/constants.ts (10.0.2.2 = emulator only).
API_URL=http://localhost:4000/api/v1
