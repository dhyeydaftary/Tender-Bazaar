# Lightweight init container — applies Prisma migrations (and, only when
# DB_INIT_SEED=true, the development seed). See docker/db-init-entrypoint.sh.
FROM node:20-alpine
WORKDIR /app

# Prisma needs OpenSSL on Alpine
RUN apk add --no-cache openssl

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Install tsx globally for running seed.ts
RUN npm install -g tsx

# Copy only what Prisma needs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma/ prisma/

# Install ONLY the root project's dependencies (prisma, @prisma/client, tsx,
# bcryptjs for the seed).
#
# This previously copied every workspace package.json "so pnpm resolves
# workspaces", which made pnpm install the dependency tree of EVERY project —
# 629 packages, including React, Next.js and the whole web/admin toolchain —
# into an image whose only job is to run `prisma migrate deploy`. `--filter
# tenderbazaar` selects the root importer alone, so the image builds from a
# fraction of the packages and carries none of the frontend tooling.
# A BuildKit cache mount for pnpm's content-addressable store. Packages
# downloaded by one build are reused by the next, so rebuilds (and CI runs with
# a warm cache) skip the network entirely instead of re-fetching the whole tree.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --filter tenderbazaar --store-dir=/pnpm-store

# Generate Prisma client
RUN npx prisma generate

# Initialization entrypoint + schema-state probe
COPY docker/db-init-entrypoint.sh docker/db-init-check.js docker/
RUN chmod +x docker/db-init-entrypoint.sh

CMD ["sh", "/app/docker/db-init-entrypoint.sh"]
