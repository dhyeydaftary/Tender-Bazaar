# Dependencies
node_modules
**/node_modules

# Build output
.next
**/dist
**/.next

# Environment files, at any depth; only the *.example templates may enter the
# build context. Secrets reach containers at runtime, never through the image.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Credentials and local user uploads
**/secrets
**/*.pem
**/*.key
**/*-firebase-adminsdk-*.json
**/*service-account*.json
**/uploads

# Version control
.git
.github
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation
*.md
!pnpm-workspace.yaml

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Test files
coverage
**/__tests__
**/*.test.ts
**/*.spec.ts

# Mobile app (not needed in Docker)
apps/mobile

# Docker files
docker-compose*.yml
Dockerfile
**/Dockerfile

# Exported Docker image bundles (docker save); never part of a build context
**/*.tar
**/*.tar.gz
**/*.tgz
