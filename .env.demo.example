# Isolated local demo — copy to .env.demo.local (git-ignored) and fill in.
# Used ONLY via:  docker compose -p tenderbazaar-demo --env-file .env.demo.local ...
# None of these values are shared with the regular .env or the existing stack.
# Generate random values with:  openssl rand -hex 24

# Demo Postgres superuser password. URL-safe characters only (A-Z a-z 0-9 - _ . ~).
POSTGRES_PASSWORD=

# Shared secret between demo api-server and demo-scraper (>= 16 chars, not a placeholder).
SCRAPER_API_TOKEN=

# Optional: one demo SUPER_ADMIN for the admin panel (password >= 12 chars).
# Created only if the email does not exist yet; never changed afterwards.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME="Demo Administrator"

# Optional: one demo ADMIN-role account, filled by the login page's "Admin" tab
# (password >= 12 chars). Created only if missing; never changed afterwards.
DEMO_STAFF_ADMIN_EMAIL=
DEMO_STAFF_ADMIN_PASSWORD=

# Optional: simulated scraper runs on a schedule as well as on demand.
DEMO_SCHEDULE_ENABLED=false
